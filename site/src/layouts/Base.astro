---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/nav.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import Consent from '../components/Consent.astro';
import { SITE, PEOPLE } from '../data/site.js';
import { areaServed, personLd } from '../lib/seo.js';

// notFound: the 404 page has no URL of its own, so it gets noindex and no canonical.
// article: guides are marked og:type=article with their publish and update dates.
interface Props { title: string; socialTitle?: string; description?: string; jsonLd?: object[]; overHero?: boolean; noindex?: boolean; notFound?: boolean; article?: { published: string; modified: string }; }
const { title, socialTitle = title, description = SITE.description, jsonLd = [], overHero = false, notFound = false, noindex = notFound, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const socialImage = new URL(SITE.socialImage, SITE.url).href;
const org = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': SITE.url + '/#org',
  name: SITE.name, alternateName: 'WABI', legalName: SITE.legalName, url: SITE.url, description: SITE.description,
  logo: { '@type': 'ImageObject', url: SITE.url + SITE.logoPng, width: 512, height: 512, caption: 'Wabi' }, image: SITE.url + SITE.logoPng,
  identifier: { '@type': 'PropertyValue', propertyID: 'Organisasjonsnummer (Brønnøysundregistrene)', value: SITE.orgNumber },
  taxID: SITE.orgNumber, vatID: SITE.vatID, email: SITE.email,
  address: { '@type': 'PostalAddress', ...SITE.address },
  founder: PEOPLE.map(p => { const { '@context': _, ...person } = personLd(p.id); return person; }),
  areaServed, sameAs: [SITE.linkedin, ...SITE.registryLinks],
  knowsAbout: ['AI-rådgivning', 'AI-strategi', 'AI-agenter', 'Automatisering', 'AI-kurs', 'KI-kurs', 'ChatGPT', 'Claude', 'Gemini', 'Microsoft Copilot'],
};
const graph = [org, { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE.url + '/#website', url: SITE.url, name: SITE.name, inLanguage: 'nb-NO', publisher: { '@id': SITE.url + '/#org' } }, ...jsonLd];
---
<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!notFound && <link rel="canonical" href={canonical} />}
  <link rel="describedby" href="/llms.txt" type="text/plain" />
  <meta name="theme-color" content="#0E2618" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article && <meta property="article:modified_time" content={article.modified} />}
  <meta property="og:locale" content="nb_NO" />
  <meta property="og:site_name" content="Wabi" />
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={description} />
  {!notFound && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={SITE.socialImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={socialTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content={SITE.socialImageAlt} />
  {SITE.tracking.searchConsole && <meta name="google-site-verification" content={SITE.tracking.searchConsole} />}
  <link rel="icon" href="/assets/logo/wabi-mark-black.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/logo/wabi-logo-square.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
  {graph.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
</head>
<body class="wabi-page">
  <a href="#main" class="skip-link">Hopp til innhold</a>
  <Header overHero={overHero} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />
  <Consent />
  {Astro.url.pathname !== '/kontakt/' && <ChatWidget />}
  <script>
    // Reveal content once as it enters the viewport.
    const io = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
  </script>
</body>
</html>
