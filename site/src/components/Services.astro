---
// The "Hva vi gjør" services block: three service panels and the course panel. Used on the homepage and service pages.
import BlobPanel from './BlobPanel.astro';
import WabiMark from './WabiMark.astro';
import ToolLogo from './ToolLogo.astro';
import Icon from './Icon.astro';
import { SERVICES } from '../data/site.js';
interface Props { eyebrow?: string; title?: string; lead?: string; }
const { eyebrow = 'Hva vi gjør', title = 'Fra en oppgave til hele bedriften.', lead = 'Vi bygger AI-agenter, automatiserer faste oppgaver og lager verktøyene som mangler. Alt i systemene dere allerede bruker.' } = Astro.props;
---
  <section class="section container" id="tjenester" aria-labelledby="services-title">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="services-title" class="section-title">{title}</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="service-panels">
      {SERVICES.map((s, i) => <div data-reveal style={`--d:${i * 90}ms`}><BlobPanel href={s.href} tone={s.tone} preset={s.preset} protect="46%" minHeight={620}>
        <WabiMark width={26} />
        <h3>{s.title}</h3>
        <p>{s.short}</p>
        <span class="panel-button">Se hvordan</span>
      </BlobPanel></div>)}
    </div>
    <div class="course-panel" data-reveal>
      <BlobPanel tone="forest" ground="paper" layout="left" preset="k1" protect="66%" contentWidth={650} minHeight={400}>
        <div class="course-label"><Icon name="workshop" size={40} /><span class="eyebrow">Kurs</span></div>
        <h3>Kurs i verktøyet dere bruker</h3>
        <p>Ett kurs, ett verktøy: Claude, ChatGPT, Gemini eller Copilot, alt etter hva dere bruker eller ønsker å bruke. Vi lærer først hvordan avdelingen jobber, og bygger kurset på oppgaver dere faktisk har. Ingen generiske kurs.</p>
        <div class="course-tools">{[['Claude', 'Claude'], ['ChatGPT', 'ChatGPT'], ['Gemini', 'Gemini'], ['Microsoft Copilot', 'Copilot']].map(([name, label]) => <span><ToolLogo name={name} size={22} />{label}</span>)}</div>
        <div class="course-actions"><a href="/kurs/" class="button button-primary">Se hvordan</a><a href="/kontakt/" class="button button-secondary">Ta en prat</a></div>
      </BlobPanel>
    </div>
  </section>

<style>
  .section { padding-block: var(--section-space); }
  .section-head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 56px; }
  .section-head .lead { color: var(--wabi-muted); }
  .section-head .lead { max-width: none; }
  .service-panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .service-panels :global(.blob-panel) { padding: 40px 28px; }
  .service-panels h3 { font-size: clamp(26px, 2.8vw, 34px); font-weight: 400; letter-spacing: -.035em; }
  .service-panels p { font-size: 15px; line-height: 1.55; color: var(--blob-panel-sub); min-height: 6.2em; }
  .panel-button { display: inline-flex; align-items: center; justify-content: center; padding: 13px 25px; margin-top: 8px; min-height: 46px; border-radius: 100px; background: #FDF9F1; border: 1px solid #E2DECF; color: #143D24; font-size: 14px; font-weight: 700; transition: background 240ms var(--ease-out); }
  .service-panels a:hover .panel-button { background: #E8EBDD; }
  .course-panel { margin-top: 16px; }
  .course-panel :global(.blob-panel) { padding: 48px; }
  .course-label { display: flex; align-items: center; gap: 12px; }
  .course-panel h3 { font-size: var(--section-title-size); font-weight: 400; letter-spacing: -.035em; line-height: 1.12; }
  .course-panel p { font-size: 16px; line-height: 1.6; }
  .course-tools, .course-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .course-tools > span { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 10px; border-radius: 100px; background: #FDF9F1; border: 1px solid #E2DECF; font-size: 14px; font-weight: 700; white-space: nowrap; }
  .course-actions { gap: 12px; margin-top: 8px; }


  @media (max-width: 1000px) {
    .service-panels { grid-template-columns: 1fr; }
    .service-panels :global(.blob-panel) { min-height: 520px !important; }
    .service-panels p { min-height: auto; margin-bottom: 16px; }
  }
  @media (max-width: 760px) { .course-panel :global(.blob-panel) { padding: 28px; } }
</style>
