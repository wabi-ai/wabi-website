---
// Text-first page opening: breadcrumbs, eyebrow, one clear H1, a short lead and at most two actions.
interface Link { label: string; href: string; }
interface Props { crumbs?: Link[]; eyebrow?: string; title: string; lead?: string; primary?: Link; secondary?: Link; }
const { crumbs = [], eyebrow, title, lead, primary, secondary } = Astro.props;
---
<section class="page-hero container">
  {crumbs.length > 0 && <nav class="crumbs mono" aria-label="Brødsmuler"><a href="/">Forside</a>{crumbs.map((c, i) => <><span aria-hidden="true">/</span>{i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}</>)}</nav>}
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1 class="display-lg" set:html={title} />
  {lead && <p class="lead">{lead}</p>}
  {(primary || secondary) && <div class="actions">
    {primary && <a href={primary.href} class="button button-primary">{primary.label}</a>}
    {secondary && <a href={secondary.href} class="button button-secondary">{secondary.label}</a>}
  </div>}
  <slot />
</section>
<style>
  .page-hero { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; padding-top: clamp(140px, 16vw, 200px); padding-bottom: clamp(48px, 6vw, 80px); }
  .crumbs { order: -2; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; color: var(--wabi-muted); font-size: 12px; }
  .crumbs a { color: var(--wabi-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--wabi-forest); }
  .crumbs [aria-current] { color: var(--wabi-forest); }
  h1 { max-width: 15em; color: var(--wabi-forest); animation: rise 900ms var(--ease-out) both; }
  .lead { color: #2E4636; animation: rise 900ms 100ms var(--ease-out) both; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; animation: rise 900ms 180ms var(--ease-out) both; }
  @media (prefers-reduced-motion: reduce) { h1, .lead, .actions { animation: none; } }
</style>
