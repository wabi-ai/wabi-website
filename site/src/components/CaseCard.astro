---
// Project card led by a miniature of the product. Used on the home page and /prosjekter/.
import CaseScreen from './CaseScreen.astro';
interface Props { href: string; kind: string; client: string; service: string; title: string; text: string; metric: string; unit: string; image?: string; imageAlt?: string; wide?: boolean; delay?: number; }
const { href, kind, client, service, title, text, metric, unit, image, imageAlt = '', wide = false, delay = 0 } = Astro.props;
---
<a href={href} class:list={['case', 'case-' + kind, { 'case-wide': wide }]} data-reveal style={`--d:${delay}ms`}>
  <div class="case-stage">{image ? <img class="shot" src={image} alt={imageAlt} width="1280" height="735" loading="lazy" /> : <CaseScreen kind={kind} />}</div>
  <div class="case-body">
    <span class="case-meta"><b>{client}</b><span>{service}</span></span>
    <h3>{title}</h3>
    <p>{text}</p>
    <span class="case-fact"><strong>{metric}</strong>{unit}</span>
    <span class="case-link">Prøv løsningen <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .case { --tint: #E6ECF3; --ink: #24466F; display: flex; flex-direction: column; overflow: hidden; border-radius: 20px; background: var(--wabi-raised); border: 1px solid var(--wabi-outline); text-decoration: none; transition: border-color 250ms ease, transform 400ms var(--ease-out); }
  .case-report { --tint: #E4EAF2; --ink: #24466F; }
  .case-dealer { --tint: #F2E3DF; --ink: #8A2A1C; }
  .case-clinic { --tint: #E9EADF; --ink: #4F5530; }
  .case-website { --tint: #E9E5F3; --ink: #5B45A8; }
  .case:hover { border-color: var(--wabi-outline-tint); transform: translateY(-4px); }
  .case:hover :global(.screen) { transform: translateY(-6px) scale(1.015); }
  .case-stage { display: flex; align-items: flex-end; justify-content: center; padding: 28px 28px 0; background: var(--tint); background-image: radial-gradient(rgba(0, 0, 0, .06) 1px, transparent 1px); background-size: 14px 14px; }
  /* Real screenshot: same frame as the miniature, cropped from the top. */
  .shot { display: block; width: 100%; height: auto; border-radius: 12px 12px 0 0; border: 1px solid rgba(0, 0, 0, .08); border-bottom: 0; box-shadow: 0 24px 50px -24px rgba(20, 30, 25, .35); object-fit: cover; object-position: top left; transition: transform 500ms var(--ease-out); }
  .case:not(.case-wide) .case-stage:has(.shot) { justify-content: flex-start; padding-right: 0; }
  .case:not(.case-wide) .shot { width: 175%; max-width: none; align-self: flex-start; border-top-right-radius: 0; }
  .case:hover .shot { transform: translateY(-6px); }
  .case-stage :global(.screen) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: -1px; }
  .case:not(.case-wide) .case-stage { height: 270px; align-items: flex-start; overflow: hidden; }
  .case-body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 24px 26px 26px; }
  .case-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 13px; }
  .case-meta b { color: var(--ink); font-weight: 800; }
  .case-meta span { color: var(--wabi-muted); }
  h3 { font-size: clamp(22px, 2vw, 27px); font-weight: 400; line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }
  p { font-size: 15px; line-height: 1.55; color: #3B4A40; }
  .case-fact { display: flex; align-items: baseline; gap: 10px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--wabi-outline); font-size: 13px; color: var(--wabi-muted); }
  .case-fact strong { font-size: 30px; font-weight: 300; letter-spacing: -.04em; color: var(--ink); }
  .case-link { display: inline-flex; gap: 8px; font-size: 14px; font-weight: 700; color: var(--wabi-forest); }
  .case-link span { transition: transform 200ms var(--ease-out); }
  .case:hover .case-link span { transform: translateX(4px); }
  .case-wide { grid-column: 1 / -1; flex-direction: row-reverse; }
  .case-wide .case-stage { flex: 1.3; padding: 40px 40px 0; }
  .case-wide .case-body { flex: 1; justify-content: center; padding: 40px; }
  .case-wide h3 { font-size: clamp(28px, 3vw, 40px); }
  .case-wide .case-fact { margin-top: 12px; }
  @media (max-width: 1000px) { .case-wide { flex-direction: column; } .case-wide .case-stage { padding: 24px 24px 0; } .case-wide .case-body { padding: 24px 26px 26px; } }
  @media (prefers-reduced-motion: reduce) { .case, .case:hover, .case:hover :global(.screen) { transform: none; } }
</style>
