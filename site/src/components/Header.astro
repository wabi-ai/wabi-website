---
import WabiMark from './WabiMark.astro';
import Icon from './Icon.astro';
import { SERVICES, COURSE } from '../data/site.js';

interface Props { overHero?: boolean; }
const { overHero = false } = Astro.props;
const items = [...SERVICES, COURSE];
const blob = (tone: string) => '/assets/blob/wabi-blob' + (tone === 'forest' ? '' : '-' + tone) + '.webp';
const icons: Record<string, string> = { agenter: 'agent', automatisering: 'flyt', programvare: 'programvare', kurs: 'workshop' };
const projects = [
  { href: '/prosjekter/rapportering/', tone: 'fjord', label: '1 / Nuet', title: 'Alle rapportene på ett sted.', text: 'Rapportverktøyet vi bygde for et markedsføringsbyrå.' },
  { href: '/prosjekter/bruktbil/', tone: 'ember', label: '2 / Programvare', title: 'En enklere salgsdag.', text: 'Utforsk et verktøy laget for bruktbilforhandleren.' },
];
---
<header class:list={['site-header', { 'is-over-hero': overHero }]} data-over-hero={overHero ? '' : undefined}>
  <div class="header-inner">
    <a href="/" class="brand-link" aria-label="Wabi, til forsiden"><WabiMark width={40} /></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-navigation"><span>Meny</span><span class="menu-symbol" aria-hidden="true"><i></i><i></i></span></button>
    <nav id="site-navigation" class="site-nav" aria-label="Hovedmeny">
      <div class="nav-links">
        <div class="nav-disclosure" data-menu="services">
          <button class="nav-link" aria-expanded="false" aria-controls="services-navigation">Hva vi gjør<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="m3 4 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
          <div class="nav-panel nav-services" id="services-navigation" hidden>
            <div class="nav-service-list">
              {items.map((s, i) => <a href={s.href} class:list={['nav-service-item', { 'is-previewed': i === 0 }]} data-preview={s.id}><span><strong>{s.navTitle || s.title}</strong><small>{s.short}</small></span><span class="nav-item-arrow" aria-hidden="true">↗</span></a>)}
            </div>
            <div class="nav-previews" aria-hidden="true">
              {items.map((s, i) => <div class:list={['nav-preview', 'nav-art-' + s.tone, { 'is-active': i === 0 }]} data-preview-panel={s.id}>
                <img src={blob(s.tone)} alt="" width="800" height="800" loading="lazy" />
                <div class="nav-preview-copy"><Icon name={icons[s.id]} size={40} onDark /><span class="nav-preview-title">{s.nav[0]}</span><p>{s.nav[1]}</p></div>
              </div>)}
            </div>
          </div>
        </div>
        <div class="nav-disclosure" data-menu="projects">
          <button class="nav-link" aria-expanded="false" aria-controls="projects-navigation">Prosjekter<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="m3 4 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
          <div class="nav-panel nav-projects" id="projects-navigation" hidden>
            <div class="nav-project-grid">
              {projects.map(p => <a href={p.href} class={'nav-project-card nav-art-' + p.tone}><img src={blob(p.tone)} alt="" width="800" height="800" loading="lazy" /><span class="nav-project-label">{p.label} <span aria-hidden="true">↗</span></span><span class="nav-project-copy"><strong>{p.title}</strong><small>{p.text}</small></span></a>)}
            </div>
            <div class="nav-project-footer" style="justify-content: flex-end"><a href="/prosjekter/">Se alle prosjekter <span aria-hidden="true">↗</span></a></div>
          </div>
        </div>
        <a href="/kartlegging/" class="nav-link">Kartlegging</a>
        <a href="/innsikt/" class="nav-link">Innsikt</a>
        <a href="/om-oss/" class="nav-link">Om oss</a>
      </div>
      <a href="/kontakt/" class="button nav-contact">La oss ta en prat <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const nav = header.querySelector<HTMLElement>('.site-nav')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const disclosures = [...header.querySelectorAll<HTMLElement>('.nav-disclosure')];
  const mobile = matchMedia('(max-width: 860px)');
  const desktop = () => matchMedia('(min-width: 861px) and (hover: hover)').matches;
  let leaveTimer: number | undefined;
  const showHeader = () => header.classList.remove('is-hidden');

  const setOpen = (target: HTMLElement | null) => {
    if (target) showHeader();
    disclosures.forEach(d => {
      const open = d === target;
      d.querySelector('button')!.setAttribute('aria-expanded', String(open));
      d.querySelector<HTMLElement>('.nav-panel')!.hidden = !open;
    });
  };
  disclosures.forEach(d => {
    const button = d.querySelector('button')!;
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') === 'true' && !desktop() ? null : d));
    d.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse' && desktop()) { clearTimeout(leaveTimer); setOpen(d); } });
    d.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse' && desktop()) leaveTimer = window.setTimeout(() => setOpen(null), 160); });
  });
  header.querySelectorAll<HTMLElement>('[data-preview]').forEach(item => {
    const show = () => {
      header.querySelectorAll('[data-preview]').forEach(el => el.classList.toggle('is-previewed', el === item));
      header.querySelectorAll('[data-preview-panel]').forEach(el => el.classList.toggle('is-active', (el as HTMLElement).dataset.previewPanel === item.dataset.preview));
    };
    item.addEventListener('pointerenter', show);
    item.addEventListener('focus', show);
  });
  const setMobileOpen = (open: boolean) => {
    if (open) showHeader();
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    header.classList.toggle('is-menu-open', open);
    toggle.querySelector('.menu-symbol')!.classList.toggle('is-open', open);
    if (!open) {
      clearTimeout(leaveTimer);
      setOpen(null);
      nav.scrollTop = 0;
    }
  };
  toggle.addEventListener('click', () => setMobileOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (mobile.matches && nav.classList.contains('is-open')) {
      setMobileOpen(false);
      toggle.focus();
    } else {
      const expanded = header.querySelector<HTMLButtonElement>('.nav-link[aria-expanded="true"]');
      setOpen(null);
      expanded?.focus();
    }
  });
  document.addEventListener('click', e => {
    if (!header.contains(e.target as Node)) setMobileOpen(false);
  });
  nav.addEventListener('click', e => {
    if ((e.target as Element).closest('a')) setMobileOpen(false);
  });
  header.addEventListener('focusout', e => {
    if (e.relatedTarget && !header.contains(e.relatedTarget as Node)) setMobileOpen(false);
  });
  mobile.addEventListener('change', () => setMobileOpen(false));
  header.addEventListener('focusin', showHeader);

  // Follow scroll direction, ignoring tiny movements and elastic overscroll on phones.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const overHero = header.hasAttribute('data-over-hero');
  const scrollPosition = () => Math.max(0, Math.min(scrollY, Math.max(0, document.documentElement.scrollHeight - innerHeight)));
  let lastY = scrollPosition(), direction = 0, travel = 0, scrollFrame = 0;
  const update = () => {
    const y = scrollPosition();
    const delta = y - lastY;
    lastY = y;
    header.classList.toggle('is-compact', y > 24);
    header.classList.toggle('is-over-hero', !!(overHero && hero && hero.hasAttribute('data-dark') && y < hero.offsetHeight - 80));
    const interacting = header.querySelector('[aria-expanded="true"], :focus-visible');
    if (y <= 180 || interacting) {
      showHeader();
      direction = 0;
      travel = 0;
      return;
    }
    if (!delta) return;
    const nextDirection = Math.sign(delta);
    travel = nextDirection === direction ? travel + Math.abs(delta) : Math.abs(delta);
    direction = nextDirection;
    // Wait for a deliberate downward scroll; reveal promptly when scrolling back.
    if (travel >= (direction > 0 ? 64 : 8)) {
      header.classList.toggle('is-hidden', direction > 0);
      travel = 0;
    }
  };
  update();
  addEventListener('scroll', () => {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(() => { scrollFrame = 0; update(); });
  }, { passive: true });
</script>
