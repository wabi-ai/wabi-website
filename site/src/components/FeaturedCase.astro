---
import { CASES } from '../data/cases.js';
const nuet = CASES.find(c => c.slug === 'rapportering')!;
const [src, caption, width, height] = nuet.shots![0];
---
<section class="container featured-case" aria-labelledby="nuet-title">
  <div class="case-copy" data-reveal>
    <span class="eyebrow">I bruk hos Nuet · Markedsføringsbyrå</span>
    <h2 id="nuet-title" class="section-title">Fra manuelle rapporter til en lenke per kunde.</h2>
    <p class="lead">Nuet samlet tall og laget rapporter for hånd. Vi bygget et verktøy som henter tallene, samler dem og forklarer endringene med AI.</p>
    <dl class="change">
      <div><dt>Før</dt><dd>Tall fra flere plattformer, regneark og vedlegg til hver kunde.</dd></div>
      <div><dt>Nå</dt><dd>Automatisk oppdaterte tall og en egen rapportlenke til kunden.</dd></div>
    </dl>
    <a class="text-link" href="/prosjekter/rapportering/">Se hva vi bygget for Nuet <span aria-hidden="true">→</span></a>
  </div>
  <figure data-reveal>
    <a class="case-image" href="/prosjekter/rapportering/" aria-label="Se rapportverktøyet vi bygget for Nuet">
      <img src={src} alt={caption} width={width} height={height} loading="lazy" />
    </a>
    <figcaption>Fra Nuets rapportverktøy. Kundedata er skjult.</figcaption>
  </figure>
</section>
<style>
  .featured-case { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-block: clamp(48px, 7vw, 96px); }
  .case-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .lead { color: #3B4A40; font-size: 17px; }
  .change { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0; }
  .change > div { border-top: 1px solid var(--wabi-outline-tint); padding-top: 14px; }
  dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; }
  dd { margin: 8px 0 0; color: #3B4A40; font-size: 14px; line-height: 1.6; }
  figure { margin: 0; min-width: 0; }
  .case-image { display: block; padding: clamp(12px, 2vw, 24px); background: #DCE4E2; border: 1px solid var(--wabi-outline-tint); border-radius: 14px; }
  img { display: block; width: 100%; height: auto; border-radius: 6px; box-shadow: 0 12px 30px -16px #143D2466; }
  figcaption { margin-top: 12px; font-size: 12px; color: var(--wabi-muted); }
  @media (max-width: 900px) { .featured-case { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 380px) { .change { grid-template-columns: minmax(0, 1fr); } }
</style>
