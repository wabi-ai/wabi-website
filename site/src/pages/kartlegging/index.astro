---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import StartingOffer from '../../components/StartingOffer.astro';
import SelfCheck from '../../components/SelfCheck.astro';
import Steps from '../../components/Steps.astro';
import FaqList from '../../components/FaqList.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbLd, faqLd, serviceLd } from '../../lib/seo.js';

const crumbs = [{ label: 'AI-kartlegging', href: '/kartlegging/' }];
const description = 'En AI-kartlegging fra Wabi viser hvilke oppgaver i bedriften der AI lønner seg, og hvor dere bør starte. Vi går gjennom arbeidsdagen sammen med dem som gjør jobben.';

const outcomes = [
  ['En oversikt over hvor tiden går', 'Oppgavene som tar tid, gjentar seg eller stopper opp, beskrevet slik de faktisk gjøres.'],
  ['Tre til fem oppgaver å starte med', 'Vi anbefaler hva dere bør gjøre først, ut fra nytten og arbeidet som kreves.'],
  ['Et konkret første prosjekt', 'En beskrivelse av den første løsningen, hvilke systemer den skal bruke, og hvordan vi sjekker om den hjelper.'],
];

const steps: [string, string][] = [
  ['Samtale med ledelsen', 'Hva dere vil oppnå, hvilke systemer dere bruker, og hva som er vanskelig i dag.'],
  ['Med dem som gjør jobben', 'Vi ser på oppgavene sammen med de ansatte. Det er der de beste mulighetene finnes.'],
  ['Hva bør gjøres først?', 'Vi vurderer hvor mye tid hver løsning kan spare, og hvor mye arbeid den krever.'],
  ['Plan', 'Dere får en plan for det første prosjektet, og bestemmer selv hvordan dere vil gå videre.'],
];

const faq: [string, string][] = [
  ['Hva er en AI-kartlegging?', 'Vi går gjennom oppgavene deres og ser hvor AI kan hjelpe. Dere får en liste over hva som er verdt å prøve, og en plan for å komme i gang.'],
  ['Hvem bør være med?', 'Noen fra ledelsen og noen av dem som gjør oppgavene hver dag. De vet best hvor tiden går.'],
  ['Hva koster det, og hvor lang tid tar det?', 'Det avhenger av hvor mye vi skal gå gjennom. Vi avklarer pris, tidsbruk og deltakere sammen med dere før kartleggingen starter.'],
  ['Bestiller vi noe ved å ta kontakt?', 'Nei. Skjemaet er en forespørsel om en samtale. En eventuell kartlegging avtales etterpå.'],
  ['Må vi forberede noe?', 'Nei. Det holder at dere vet hvilke systemer dere bruker. Resten finner vi ut sammen.'],
  ['Hva skjer etter kartleggingen?', 'Dere bestemmer. Vi kan bygge det første prosjektet sammen med dere, eller dere kan ta planen videre på egen hånd.'],
];
---
<Base title="AI-kartlegging for bedrifter | Wabi" description={description} jsonLd={[breadcrumbLd(crumbs), faqLd(faq), serviceLd({ name: 'AI-kartlegging', description, path: '/kartlegging/' })]}>
  <PageHero crumbs={crumbs} eyebrow="AI-kartlegging" title="Finn ut hvor AI kan hjelpe dere."
    lead="Vi snakker med dere om oppgavene som tar tid. Sammen finner vi ut hva AI kan hjelpe med, og hva dere bør prøve først."
    primary={{ label: 'Ta en prat om kartlegging', href: '/kontakt/' }} secondary={{ label: 'Ta selvtesten', href: '#selvtest' }} />

  <StartingOffer detail />

  <section class="section container split" aria-labelledby="fa-title">
    <div class="split-head sticky-head" data-reveal><span class="eyebrow">Det dere får</span><h2 id="fa-title" class="display-md">Dette får dere med videre.</h2></div>
    <ol class="outcomes">{outcomes.map(([t, s], i) => <li data-reveal style={`--d:${i * 80}ms`}><span class="mono">{i + 1}</span><div><h3>{t}</h3><p>{s}</p></div></li>)}</ol>
  </section>

  <Steps dark eyebrow="Slik foregår det" title="Fra samtale til plan." steps={steps} />
  <div id="selvtest"><Band tone="forest"><SelfCheck /></Band></div>
  <FaqList faq={faq} title="Om AI-kartlegging." />
  <CtaPanel eyebrow="Neste steg" title="Ta en prat om kartlegging." text="Vi starter med behovet deres og avklarer hva en kartlegging vil innebære før dere bestemmer dere." secondary={null} />
</Base>

<style>
  .outcomes { list-style: none; margin: 0; padding: 0; }
  .outcomes li { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 28px 0; border-bottom: 1px solid var(--wabi-outline); }
  .outcomes li:first-child { border-top: 1px solid var(--wabi-outline); }
  .outcomes .mono { padding-top: 6px; color: var(--wabi-moss); }
  .outcomes h3 { font-size: clamp(20px, 1.9vw, 24px); font-weight: 400; letter-spacing: -.025em; }
  .outcomes p { margin-top: 8px; color: #3B4A40; }
</style>
