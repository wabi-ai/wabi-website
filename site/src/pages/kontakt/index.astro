---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbLd } from '../../lib/seo.js';
import { SITE } from '../../data/site.js';

const crumbs = [{ label: 'Kontakt', href: '/kontakt/' }];
const contactLd = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Kontakt Wabi', url: SITE.url + '/kontakt/', about: { '@id': SITE.url + '/#org' } };
---
<Base title="Kontakt Wabi | AI-rådgivning" description="Ta kontakt med Wabi. Fortell hva dere bruker mye tid på, så ser vi sammen på om AI kan gjøre arbeidsdagen enklere." jsonLd={[breadcrumbLd(crumbs), contactLd]}>
  <PageHero crumbs={crumbs} eyebrow="Kontakt" title="En oppgave er nok å starte med."
    lead="Fortell hva dere bruker mye tid på. Du trenger ikke en ferdig plan. En konkret utfordring fra hverdagen er et godt utgangspunkt." />

  <section class="container contact">
    <aside class="person" data-reveal>
      <img src="/assets/portraits/ulrik-rosmael-bue-blob-hoyre.webp" alt="Ulrik Rosmæl" width="240" height="240" />
      <div>
        <strong>Ulrik Rosmæl</strong>
        <span>Din første kontakt hos Wabi</span>
        <a href={'mailto:' + SITE.email}>{SITE.email}</a>
      </div>
    </aside>

    <form class="composer" data-composer data-reveal>
      <label><span>Hva vil dere få til?</span><textarea name="goal" rows="4" placeholder="For eksempel: raskere tilbud, færre e-poster i innboksen, bedre rapporter"></textarea></label>
      <label><span>Hva tar mest tid i dag?</span><textarea name="time" rows="4" placeholder="Beskriv en oppgave slik den gjøres i dag"></textarea></label>
      <div class="row">
        <label><span>Navn</span><input name="name" autocomplete="name" /></label>
        <label><span>Bedrift</span><input name="company" autocomplete="organization" /></label>
      </div>
      <div class="send">
        <button type="submit" class="button button-primary">Åpne e-postutkast</button>
        <p>Utkastet åpnes i e-postappen din. Du leser gjennom og sender selv til {SITE.email}.</p>
      </div>
      <details class="fallback">
        <summary>Åpnet ikke e-postappen seg?</summary>
        <p>Kopier meldingen og send den til <a href={'mailto:' + SITE.email}>{SITE.email}</a>.</p>
        <pre data-preview></pre>
        <button type="button" class="button button-secondary" data-copy>Kopier meldingen</button>
        <span class="copied" data-copied role="status"></span>
      </details>
    </form>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-composer]');
  if (form) {
    const email = 'ulrik@wabi.no';
    const compose = () => {
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      return `Hei Ulrik,\n\nDette vil vi få til:\n${v('goal') || '(ikke fylt ut)'}\n\nDette tar mest tid i dag:\n${v('time') || '(ikke fylt ut)'}\n\nHilsen\n${[v('name'), v('company')].filter(Boolean).join(', ')}`;
    };
    const preview = form.querySelector<HTMLElement>('[data-preview]')!;
    form.addEventListener('input', () => { preview.textContent = compose(); });
    preview.textContent = compose();
    form.addEventListener('submit', e => {
      e.preventDefault();
      const company = String(new FormData(form).get('company') || '').trim();
      location.href = `mailto:${email}?subject=${encodeURIComponent('Henvendelse fra wabi.no' + (company ? ', ' + company : ''))}&body=${encodeURIComponent(compose())}`;
    });
    form.querySelector('[data-copy]')!.addEventListener('click', async () => {
      const status = form.querySelector<HTMLElement>('[data-copied]')!;
      try { await navigator.clipboard.writeText(compose()); status.textContent = 'Meldingen er kopiert.'; }
      catch { status.textContent = 'Kopiering er ikke tilgjengelig. Marker og kopier teksten over.'; }
    });
  }
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(32px, 6vw, 96px); align-items: start; padding-bottom: var(--section-space); }
  .person { position: sticky; top: 120px; display: flex; flex-direction: column; gap: 20px; }
  .person img { width: min(240px, 100%); height: auto; }
  .person div { display: flex; flex-direction: column; gap: 4px; }
  .person strong { font-size: 20px; }
  .person span { color: var(--wabi-muted); font-size: 14px; }
  .person a { margin-top: 8px; font-weight: 700; color: var(--wabi-moss); }
  .composer { display: flex; flex-direction: column; gap: 20px; padding: clamp(24px, 3vw, 40px); border-radius: 20px; background: var(--wabi-card); border: 1px solid var(--wabi-outline); }
  label { display: flex; flex-direction: column; gap: 8px; }
  label span { font-weight: 700; font-size: 15px; }
  textarea, input { width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--wabi-outline); background: var(--wabi-raised); color: var(--wabi-forest); font: 16px/1.5 var(--font-sans); resize: vertical; }
  textarea:focus, input:focus { outline: 2px solid var(--wabi-moss); outline-offset: 1px; }
  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .send { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .send p { flex: 1; min-width: 220px; font-size: 13px; color: var(--wabi-muted); }
  .fallback summary { cursor: pointer; font-size: 14px; font-weight: 700; color: var(--wabi-moss); }
  .fallback p { margin: 12px 0; font-size: 14px; }
  pre { margin: 0 0 12px; padding: 16px; border-radius: 12px; background: var(--wabi-raised); border: 1px solid var(--wabi-outline); white-space: pre-wrap; font: 13px/1.6 var(--font-mono); }
  .copied { margin-left: 12px; font-size: 13px; color: var(--wabi-moss); }
  @media (max-width: 860px) { .contact { grid-template-columns: minmax(0, 1fr); } .person { position: static; flex-direction: row; align-items: center; } .person img { width: 120px; } .row { grid-template-columns: minmax(0, 1fr); } }
</style>
