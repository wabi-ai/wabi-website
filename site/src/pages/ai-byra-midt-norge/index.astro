---
// Regional landing page for "AI-byrå Midt-Norge" (Trøndelag + Møre og Romsdal).
// Angle: the "Midt-Norges mest praktiske AI-byrå" positioning, the coast, and how a project runs at a distance.
// Keep the copy distinct from /ai-byra-trondheim/ and /ai-byra-trondelag/ (no doorway pages).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import FaqList from '../../components/FaqList.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbLd, faqLd, serviceLd } from '../../lib/seo.js';

const path = '/ai-byra-midt-norge/';
const crumbs = [{ label: 'AI-byrå i Midt-Norge', href: path }];
const description = 'AI-byrå i Midt-Norge for bedrifter i Trøndelag og Møre og Romsdal. Vi starter hos dere, bygger løsningen i systemene dere har og følger den opp etterpå.';
const area = {
  '@type': 'Place', name: 'Midt-Norge',
  containsPlace: [{ '@type': 'AdministrativeArea', name: 'Trøndelag' }, { '@type': 'AdministrativeArea', name: 'Møre og Romsdal' }],
};

const plan = [
  ['Hos dere', 'Oppstart og kartlegging', 'Vi kommer til dere, snakker med ledelsen og ser på oppgavene sammen med dem som gjør dem.'],
  ['På nett', 'Plan og avklaringer', 'Dere får et forslag til første prosjekt. Data, leverandører, eierskap og oppfølging avklares før vi bygger.'],
  ['På nett', 'Bygging og prøving', 'Dere tester en tidlig versjon med egne oppgaver og sier fra om det som må endres.'],
  ['Etter avtale', 'Opplæring og lansering', 'De ansatte lærer å bruke løsningen. Et menneske godkjenner der det trengs.'],
  ['På nett', 'Oppfølging', 'Vi følger med på hvordan løsningen brukes og gjør den bedre underveis.'],
];

const services = [
  ['AI-kartlegging', '/kartlegging/', 'Gjøres hos dere. Vi finner tre til fem oppgaver der AI lønner seg, og anbefaler hvor dere bør starte.'],
  ['AI-strategi', '/ai-strategi/', 'En felles plan for hva hele bedriften bruker AI til: mål, verktøy, regler for trygg bruk og opplæring.'],
  ['AI-agenter', '/ai-agenter/', 'Digitale hjelpere som lager rapporter, skriver svar og følger opp oppgaver. Dere bestemmer hva som må godkjennes.'],
  ['Automatisering', '/automatisering/', 'Koblinger mellom systemene dere har, så ingen trenger å flytte informasjon for hånd.'],
  ['Verktøy og programvare', '/verktoy-og-programvare/', 'Vi rydder i verktøyene dere betaler for, og bygger det som mangler når ferdige programmer ikke passer oppgaven.'],
  ['Kurs', '/kurs/', 'Ett kurs, ett verktøy: Claude, ChatGPT, Gemini eller Copilot, bygget på oppgavene avdelingen faktisk har.'],
];

const faq: [string, string][] = [
  ['Tar dere oppdrag i Møre og Romsdal?', 'Ja. Midt-Norge er hovedområdet vårt, og det omfatter både Trøndelag og Møre og Romsdal. Vi starter gjerne prosjektet hos dere, og tar mye av arbeidet etterpå på nett.'],
  ['Hvordan følger dere opp når dere ikke er i nærheten?', 'Før lansering avtaler vi hva oppfølging, support og videre utvikling skal omfatte, og hva det koster. Deretter følger vi med på hvordan løsningen brukes og justerer den sammen med dem som bruker den.'],
  ['Hvorfor velge et AI-byrå i regionen?', 'Det viktigste er at de som bygger løsningen, har satt seg inn i hvordan dere jobber. Fra Trondheim er veien kort nok til at vi kan komme til dere når det betyr mest, for eksempel ved oppstart.'],
  ['Hvor blir dataene våre behandlet?', 'Det bestemmes for hvert prosjekt. Før vi starter, går vi gjennom hvilke data løsningen trenger, hvilke leverandører som behandler dem og hvem som får tilgang. Kravene deres styrer valgene.'],
  ['Hva koster et prosjekt?', 'Det avhenger av oppgaven og omfanget. Vi avtaler pris, tidsbruk og deltakere før en kartlegging, og dere bestemmer selv om dere vil gå videre etterpå.'],
];
---
<Base title="AI-byrå i Midt-Norge: Trøndelag og Møre og Romsdal | Wabi" description={description} jsonLd={[breadcrumbLd(crumbs), faqLd(faq), serviceLd({ name: 'AI-byrå i Midt-Norge', description, path, area })]}>
  <PageHero crumbs={crumbs} eyebrow="Midt-Norges mest praktiske AI-byrå" title="Et AI-byrå for hele Midt-Norge."
    lead="Midt-Norge er Trøndelag og Møre og Romsdal. Vi har base i Trondheim og tar oppdrag i hele regionen. Starten skjer hos dere. Resten av prosjektet kan gå på nett, uten at dere mister kontakten med dem som bygger."
    primary={{ label: 'AI-prat?', href: '/kontakt/' }} secondary={{ label: 'Slik går et prosjekt', href: '#prosjektet' }} />

  <section class="section container split rule-top" aria-labelledby="praktisk-title">
    <div class="split-head" data-reveal><span class="eyebrow">Hvorfor «praktisk»</span><h2 id="praktisk-title" class="display-md">Hva vi mener med praktisk AI.</h2></div>
    <div data-reveal>
      <p class="answer">For oss betyr praktisk at noe blir tatt i bruk. Vi starter med én oppgave, får den til å virke, og utvider når dere ser at den hjelper. Vi skriver ikke lange utredninger om hva AI kanskje kan gjøre en dag.</p>
      <p class="answer muted">Navnet Wabi kommer fra wabi-sabi: framdrift foran perfeksjon, enkle løsninger og et menneske som har det siste ordet.</p>
    </div>
  </section>

  <section id="prosjektet" class="plan-section" aria-labelledby="plan-title">
    <div class="container plan-intro" data-reveal><span class="eyebrow">Over avstand</span><h2 id="plan-title" class="display-md">Slik går et prosjekt i Midt-Norge.</h2><p>Når vi ikke er naboer, legger vi de viktigste møtene hos dere og resten på nett.</p></div>
    <Band tone="deep">
      <article class="paper-card plan" aria-label="Et prosjekt fra oppstart til oppfølging">
        <h3>Fra oppstart til oppfølging</h3>
        <ol>{plan.map(([where, t, s], i) => <li><span class:list={['where', { onsite: where === 'Hos dere' }]}>{where}</span><div><strong>{i + 1}. {t}</strong><p>{s}</p></div></li>)}</ol>
        <p class="illustration-note">Hvor mye vi møtes fysisk etter oppstarten, avtaler vi med dere.</p>
      </article>
    </Band>
  </section>

  <section class="section container split" aria-labelledby="kyst-title">
    <div class="split-head" data-reveal><span class="eyebrow">Havbruk og maritim næring</span><h2 id="kyst-title" class="display-md">AI for bedrifter langs kysten.</h2></div>
    <div data-reveal>
      <p class="answer">Langs kysten i Midt-Norge er havbruk og maritim næring viktige. Mye av arbeidet handler om å holde oversikt: målinger, rapporter, søknader og dokumentasjon.</p>
      <p class="answer muted">For et havbruksselskap har vi samlet driftsoversikt, nøkkeltall og utkast til søknader om støtte på de samme dataene. Kundecaset er anonymisert, og vi kaller selskapet <a class="text-link" href="/prosjekter/havbruk/">Havora</a>.</p>
      <p class="answer muted">Andre oppgaver som ofte passer, er å samle tall fra flere systemer i én rapport, skrive førsteutkast til dokumentasjon og finne svar i egne rutiner. Et menneske kontrollerer før noe sendes.</p>
    </div>
  </section>

  <section class="section container rule-top" aria-labelledby="tjenester-title">
    <div class="svc-head" data-reveal><span class="eyebrow">Tjenester</span><h2 id="tjenester-title" class="display-md">Det vi leverer i Midt-Norge.</h2></div>
    <ul class="svc">{services.map(([t, href, s], i) => <li data-reveal style={`--d:${i * 50}ms`}><a href={href}><h3>{t}</h3><p>{s}</p><span class="arrow" aria-hidden="true">→</span></a></li>)}</ul>
    <p class="note" data-reveal>Et eksempel på en løsning som brukes uansett hvor folk sitter: <a href="/prosjekter/rapportering/">rapportverktøyet til Nuet</a>, der hver kunde har sin egen lenke.</p>
  </section>

  <section class="section container split rule-top" aria-labelledby="folk-title">
    <div class="split-head" data-reveal><span class="eyebrow">Hvem dere møter</span><h2 id="folk-title" class="display-md">Dere møter dem som gjør jobben.</h2></div>
    <div data-reveal>
      <p class="answer">Ulrik Rosmæl, daglig leder og AI-konsulent, jobber fra Trondheim. Eljar Skjørholm, Chief AI Officer, jobber fra Singapore. Vi er vant til å samarbeide over avstand, og det er de samme folkene som kartlegger, bygger og følger opp.</p>
      <p class="answer muted"><a class="text-link" href="/om-oss/">Les mer om oss</a></p>
    </div>
  </section>

  <FaqList faq={faq} title="Om å jobbe med oss i Midt-Norge." />
  <p class="container also" data-reveal>Leter dere etter hjelp nærmere? Se <a href="/ai-byra-trondheim/">AI-byrå i Trondheim</a> og <a href="/ai-byra-trondelag/">AI-byrå i Trøndelag</a>.</p>
  <CtaPanel eyebrow="Midt-Norge" title="Start med en samtale, der dere er." text="Fortell hva dere vil forbedre. Vi avtaler en oppstart hos dere og hvordan resten av prosjektet skal gå." primary={{ label: 'AI-prat?', href: '/kontakt/' }} secondary={{ label: 'Om oss', href: '/om-oss/' }} />
</Base>

<style>
  .plan-section { padding-bottom: var(--section-space); }
  .plan-intro { display: flex; flex-direction: column; gap: 18px; padding-top: var(--section-space); margin-bottom: clamp(28px, 3vw, 40px); }
  .plan-intro p { color: #3B4A40; font-size: 17px; }
  .plan ol { list-style: none; margin: 18px 0 0; padding: 0; }
  .plan li { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-top: 1px solid var(--wabi-outline); }
  .where { align-self: start; justify-self: start; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--wabi-outline); background: var(--wabi-card); white-space: nowrap; }
  .where.onsite { background: var(--wabi-tint); border-color: var(--wabi-outline-tint); color: var(--wabi-moss); }
  .plan strong { font-size: 16px; }
  .plan li p { margin-top: 4px; font-size: 15px; color: #3B4A40; }
  .svc-head { display: flex; flex-direction: column; gap: 18px; margin-bottom: clamp(28px, 3vw, 40px); }
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .svc a { position: relative; display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 28px 28px 48px; border-radius: 14px; border: 1px solid var(--wabi-outline); background: var(--wabi-raised); text-decoration: none; color: inherit; transition: border-color 200ms; }
  .svc a:hover { border-color: var(--wabi-moss); }
  .svc h3 { font-size: 22px; font-weight: 400; letter-spacing: -.025em; }
  .svc p { font-size: 15px; color: #3B4A40; }
  .svc .arrow { position: absolute; left: 28px; bottom: 18px; color: var(--wabi-moss); font-weight: 700; }
  .note, .also { margin-top: 24px; color: var(--wabi-muted); }
  .also { padding-bottom: clamp(32px, 4vw, 48px); }
  .note a, .also a { color: var(--wabi-moss); font-weight: 700; }
  @media (max-width: 900px) { .svc { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .plan li { grid-template-columns: minmax(0, 1fr); gap: 8px; } }
</style>
