---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbLd } from '../../lib/seo.js';
import { CASES } from '../../data/cases.js';
import { Dashboard, AdsAndAudience } from '../../react/ReportUI.jsx';
import { DealerApp } from '../../react/DealerUI.jsx';
import '../../styles/demo.css';

export function getStaticPaths() {
  return CASES.map(c => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const crumbs = [{ label: 'Prosjekter', href: '/prosjekter/' }, { label: c.category, href: `/prosjekter/${c.slug}/` }];
const others = CASES.filter(x => x.slug !== c.slug).slice(0, 3);
---
<Base title={c.seoTitle || `${c.title.replace(/\.$/, '')} | ${c.category} | Wabi`} description={c.lead} jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow={c.client ? c.service : `${c.category} · ${c.service}`} title={c.title} lead={c.lead}>
    {c.logo && <img class="client-logo" src={c.logo} alt={c.client} height="40" />}
    {c.note && <p class="note mono">{c.note}</p>}
  </PageHero>

  {c.demo ? <>
    <section class="container facts-row" aria-label="Fakta om prosjektet">
      <dl>{c.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      {c.flow && <ol class="flow">{c.flow.map(([t, s], i) => <li><span class="mono">{i + 1}</span><strong>{t}</strong><span>{s}</span></li>)}</ol>}
    </section>
    <section aria-label="Slik ser det ut">
      <Band tone={c.tone}>
        <div class="demo-wrap">
          <p class="demo-note">{c.demoNote}</p>
          {c.demo === 'report' && <><Dashboard client:visible /><AdsAndAudience client:visible /></>}
          {c.demo === 'dealer' && <DealerApp client:visible />}
        </div>
      </Band>
    </section>
  </> : <Band tone={c.tone}>
    <div class="paper-card facts">
      <dl>{c.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      {c.flow && <ol class="flow">{c.flow.map(([t, s], i) => <li><span class="mono">{i + 1}</span><strong>{t}</strong><span>{s}</span></li>)}</ol>}
    </div>
  </Band>}

  <section class="section container split" aria-labelledby="built-title">
    <div class="split-head sticky-head" data-reveal><span class="eyebrow">Hva vi bygde</span><h2 id="built-title" class="display-md">Løsningen, del for del.</h2></div>
    <ol class="built">{c.built.map(([t, s], i) => <li data-reveal style={`--d:${i * 60}ms`}><span class="mono">{i + 1}</span><div><h3>{t}</h3><p>{s}</p></div></li>)}</ol>
  </section>

  {c.spec && <section class="section-tight container rule-top spec" aria-labelledby="spec-title">
    <div class="split-head" data-reveal><span class="eyebrow">Oppgavebeskrivelsen</span><h2 id="spec-title" class="display-md">Slik er agenten instruert.</h2></div>
    <dl class="spec-list" data-reveal>{c.spec.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
  </section>}

  {c.before && <section class="section-tight container rule-top ba" aria-labelledby="ba-title">
    <div class="split-head" data-reveal><span class="eyebrow">Før og etter</span><h2 id="ba-title" class="display-md">Hva som endret seg.</h2></div>
    <div class="ba-grid">
      <div data-reveal><h3>Før</h3><ul>{c.before.map(b => <li>{b}</li>)}</ul></div>
      <div data-reveal style="--d:100ms"><h3>Etter</h3><ul>{c.after.map(b => <li>{b}</li>)}</ul></div>
    </div>
  </section>}

  <section class="section-tight container rule-top" aria-labelledby="more-title">
    <h2 id="more-title" class="eyebrow">Flere prosjekter</h2>
    <ul class="others">{others.map(o => <li><a href={`/prosjekter/${o.slug}/`}><span class="mono">{o.category}</span><strong>{o.title}</strong><span aria-hidden="true">↗</span></a></li>)}</ul>
  </section>

  {c.cta ? <CtaPanel tone={c.tone} eyebrow={c.category} title={c.cta[0]} text={c.cta[1]} primary={{ label: 'Ta kontakt', href: '/kontakt/' }} secondary={null} /> : <CtaPanel />}
</Base>

<style>
  .note { margin-top: 4px; font-size: 12px; color: var(--wabi-muted); }
  .client-logo { order: -1; width: auto; height: 34px; margin-bottom: 6px; }
  .facts-row { padding-bottom: 40px; }
  .facts-row dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 24px 0; border-top: 1px solid var(--wabi-outline); border-bottom: 1px solid var(--wabi-outline); }
  .facts-row dt { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--wabi-muted); }
  .facts-row dd { margin: 6px 0 0; font-size: 15px; font-weight: 700; }
  .facts-row .flow { border-top: 0; margin-top: 8px; }
  .demo-wrap { display: flex; flex-direction: column; gap: 20px; width: min(1180px, 100%) !important; }
  .demo-note { color: rgba(244, 241, 231, .85); font-size: 14px; text-align: center; }
  .facts { width: min(900px, 100%) !important; }
  .facts dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0; }
  .facts dt { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--wabi-muted); }
  .facts dd { margin: 6px 0 0; font-size: 15px; }
  .flow { list-style: none; margin: 28px 0 0; padding: 20px 0 0; border-top: 1px solid var(--wabi-outline); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .flow li { display: flex; flex-direction: column; gap: 6px; }
  .flow .mono { color: var(--wabi-moss); font-size: 11px; }
  .flow strong { font-size: 16px; }
  .flow span:last-child { font-size: 13px; color: var(--wabi-muted); }
  .built { list-style: none; margin: 0; padding: 0; }
  .built li { display: grid; grid-template-columns: 48px 1fr; gap: 20px; padding: 28px 0; border-bottom: 1px solid var(--wabi-outline); }
  .built li:first-child { border-top: 1px solid var(--wabi-outline); }
  .built .mono { padding-top: 6px; color: var(--wabi-moss); }
  .built h3 { font-size: clamp(20px, 1.9vw, 24px); font-weight: 400; letter-spacing: -.025em; }
  .built p { margin-top: 8px; color: #3B4A40; }
  .spec .split-head, .ba .split-head { margin-bottom: 40px; }
  .spec-list { display: grid; grid-template-columns: 160px 1fr; gap: 16px 24px; margin: 0; padding: clamp(24px, 3vw, 40px); border-radius: 18px; background: var(--wabi-tint); border: 1px solid var(--wabi-outline-tint); max-width: 900px; }
  .spec-list dt { font-weight: 700; }
  .spec-list dd { margin: 0; color: #2E4636; }
  .ba-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .ba-grid > div { padding: clamp(24px, 3vw, 40px); border-radius: 18px; border: 1px solid var(--wabi-outline); background: var(--wabi-card); }
  .ba-grid > div + div { background: var(--wabi-tint); border-color: var(--wabi-outline-tint); }
  .ba-grid h3 { font-size: 28px; font-weight: 400; letter-spacing: -.03em; }
  .ba-grid ul { list-style: none; margin: 16px 0 0; padding: 0; }
  .ba-grid li { padding: 14px 0; border-top: 1px solid var(--wabi-outline); }
  .others { list-style: none; margin: 24px 0 0; padding: 0; }
  .others a { display: grid; grid-template-columns: 160px 1fr auto; gap: 20px; align-items: baseline; padding: 24px 0; border-bottom: 1px solid var(--wabi-outline); text-decoration: none; }
  .others li:first-child a { border-top: 1px solid var(--wabi-outline); }
  .others .mono { font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: var(--wabi-moss); }
  .others strong { font-size: clamp(20px, 2vw, 26px); font-weight: 400; letter-spacing: -.025em; }
  .others a:hover strong { color: var(--wabi-moss); }
  @media (max-width: 860px) {
    .facts dl, .facts-row dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow { grid-template-columns: minmax(0, 1fr); }
    .spec-list { grid-template-columns: minmax(0, 1fr); gap: 4px; } .spec-list dd { margin-bottom: 12px; }
    .ba-grid { grid-template-columns: minmax(0, 1fr); }
    .others a { grid-template-columns: 1fr auto; } .others .mono { grid-column: 1 / -1; }
  }
</style>
