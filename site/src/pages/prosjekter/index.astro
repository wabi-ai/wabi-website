---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CaseRail from '../../components/CaseRail.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbLd } from '../../lib/seo.js';
const crumbs = [{ label: 'Prosjekter', href: '/prosjekter/' }];
---
<Base title="Prosjekter: AI-agenter, automatisering og programvare | Wabi" description="Eksempler på AI-agenter, automatisering og programvare Wabi bygger for norske bedrifter: rapportering, bruktbilhandel, legekontor og nettsider." jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="Prosjekter" title="Dette har vi laget for kundene våre." lead="Se hvordan vi har gjort rapportering, bilsalg og andre oppgaver enklere." />
  <section class="container"><CaseRail layout="grid" /></section>
  <div class="spacer"></div>
  <CtaPanel />
</Base>
<style>
  .spacer { height: var(--section-space); }
</style>
