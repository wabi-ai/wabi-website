---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Band from '../../components/Band.astro';
import Console from '../../components/hero/Console.astro';
import Examples from '../../components/Examples.astro';
import Steps from '../../components/Steps.astro';
import FaqList from '../../components/FaqList.astro';
import MoreServices from '../../components/MoreServices.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { breadcrumbLd, faqLd, serviceLd } from '../../lib/seo.js';

const crumbs = [{ label: 'AI-agenter', href: '/ai-agenter/' }];
const description = 'Wabi bygger digitale hjelpere som lager rapporter, skriver svar og følger opp oppgaver i systemene dere bruker. Dere bestemmer hva som må godkjennes.';

const examples = [
  { title: 'Ukesrapport for salg', text: 'Samler salgstall og skriver ukesrapporten. Viser hvilke kunder som ikke har blitt fulgt opp på 14 dager.', tools: ['HubSpot', 'Excel', 'Slack'] },
  { title: 'Svar på kundespørsmål', text: 'Bruker bedriftens egne dokumenter til å svare på vanlige spørsmål. Sender resten til riktig person, sammen med den tidligere samtalen.', tools: ['Gmail', 'Notion', 'Microsoft Teams'] },
  { title: 'Tilbud fra forespørsel', text: 'Leser forespørselen og kundehistorikken, henter priser og avtalte rabatter, og legger et utkast klart til gjennomlesning.', tools: ['Outlook', 'Salesforce'] },
  { title: 'Forberedelser til nye kundemøter', text: 'Finner informasjon om mulige kunder. Legger den i kundesystemet og foreslår hvordan selgeren kan følge opp.', tools: ['HubSpot', 'Google Sheets'] },
  { title: 'Kontroll av fakturaer', text: 'Sjekker at fakturaen stemmer med bestillingen. Ber om godkjenning hvis noe er feil.', tools: ['Gmail', 'Excel'] },
];

const steps: [string, string][] = [
  ['Oppgaven', 'Vi beskriver oppgaven sammen: Hva skal gjøres, hvilken informasjon trengs, og når er jobben ferdig?'],
  ['Tilgangen', 'Den digitale hjelperen får egen innlogging og bare tilgang til det den trenger for å gjøre jobben.'],
  ['Arbeidet', 'Den leser informasjonen, gjør oppgaven steg for steg og sjekker resultatet.'],
  ['Mennesket', 'Dere bestemmer hva som må godkjennes. Dere kan se hva den digitale hjelperen har gjort.'],
];

const faq: [string, string][] = [
  ['Hva er forskjellen på en AI-agent og en chatbot?', 'En chatbot svarer på det du skriver. En agent får en oppgave og løser den: den henter data, gjør flere steg etter hverandre og leverer et ferdig resultat, for eksempel en rapport eller et svarutkast.'],
  ['Hvilke systemer kan en agent jobbe i?', 'Den kan jobbe med e-post, regneark, dokumenter og kundesystemer som HubSpot og Salesforce. Vi undersøker først hvilke av systemene deres som kan kobles sammen.'],
  ['Hva skjer hvis agenten gjør en feil?', 'Dere bestemmer hva den får gjøre på egen hånd. Andre oppgaver må godkjennes av dere. Hvert steg blir lagret, så dere kan undersøke hva som har skjedd.'],
  ['Hvilken AI bruker dere?', 'Vi velger den AI-en som passer oppgaven, for eksempel Claude, GPT eller Gemini. Vi hjelper dere å velge og sette den opp.'],
  ['Hvordan starter en agent?', 'En person kan skrive til den, den kan gå på et fast tidspunkt, for eksempel hver mandag 07:00, eller den kan starte når noe skjer i et system: en ny e-post, en ny kundehenvendelse eller en signert avtale.'],
];
---
<Base title="AI-agenter for bedrifter | Wabi" description={description} jsonLd={[breadcrumbLd(crumbs), faqLd(faq), serviceLd({ name: 'AI-agenter', description, path: '/ai-agenter/' })]}>
  <PageHero crumbs={crumbs} eyebrow="AI-agenter" title="Få hjelp med oppgavene som tar tid."
    lead="En AI-agent er en digital hjelper. Den kan lage rapporter, skrive svar til kunder og følge opp oppgaver. Dere bestemmer hva den får gjøre, og hva dere vil godkjenne først."
    primary={{ label: 'Ta en prat', href: '/kontakt/' }} secondary={{ label: 'Se eksempler', href: '#eksempler' }} />

  <Band tone="fjord"><Console theme="light" only={['rapport', 'kundeservice', 'tilbud']} /></Band>

  <section class="section container split" aria-labelledby="hva-title">
    <div class="split-head" data-reveal><span class="eyebrow">Kort forklart</span><h2 id="hva-title" class="display-md">Hva er en AI-agent?</h2></div>
    <div data-reveal>
      <p class="answer">En AI-agent er et program som kan gjøre flere steg i en oppgave. Den kan for eksempel hente salgstall, sammenligne dem og skrive en rapport.</p>
      <p class="answer muted">En chatbot svarer på spørsmål. En agent kan også gjøre arbeid i systemene dere bruker, som å oppdatere kundeopplysninger eller lage et svarutkast.</p>
    </div>
  </section>

  <section class="section container rule-top spec" aria-labelledby="spec-title">
    <div class="split-head" data-reveal>
      <span class="eyebrow">Det som avgjør kvaliteten</span>
      <h2 id="spec-title" class="display-md">En tydelig oppgave gir et bedre resultat.</h2>
    </div>
    <div class="spec-grid">
      <div class="spec-card vague" data-reveal>
        <span class="mono">Vag oppgave</span>
        <p class="spec-quote">«Lag en ukesrapport for salg.»</p>
        <p class="muted">Agenten må gjette hvilke tall, hvilken periode, hvilket format og hva den skal gjøre med avvik.</p>
      </div>
      <div class="spec-card precise" data-reveal style="--d:120ms">
        <span class="mono">Presis oppgave</span>
        <dl>
          <dt>Rolle</dt><dd>Du lager ukesrapporten for salgsteamet.</dd>
          <dt>Informasjon</dt><dd>Salgsaktiviteter fra kundesystemet og omsetning fra regnskapet for forrige uke.</dd>
          <dt>Steg</dt><dd>Grupper per selger. Tre punkter per selger. Marker avtaler uten kontakt på 14 dager.</dd>
          <dt>Ferdig når</dt><dd>Rapporten ligger i delt mappe i fast mal.</dd>
          <dt>Stopp og spør</dt><dd>Hvis tallene i kundesystemet og regnskapet skiller seg med mer enn 5 000 kr.</dd>
        </dl>
      </div>
    </div>
  </section>

  <div id="eksempler"><Examples eyebrow="Eksempler" title="Oppgaver en agent kan ta for dere." intro="Felles for dem: oppgaven gjentar seg, følger et mønster og tar tid fra noe viktigere." items={examples} /></div>

  <Steps dark eyebrow="Slik bygger vi en agent" title="Fire ting må være på plass." steps={steps} />

  <FaqList faq={faq} title="Om AI-agenter." />
  <MoreServices current="agenter" />
  <CtaPanel />
</Base>

<style>
  .spec .split-head { max-width: 760px; margin-bottom: 48px; }
  .spec-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 16px; }
  .spec-card { display: flex; flex-direction: column; gap: 18px; padding: clamp(24px, 3vw, 40px); border-radius: 18px; border: 1px solid var(--wabi-outline); background: var(--wabi-card); }
  .spec-card .mono { text-transform: uppercase; letter-spacing: .12em; font-size: 11px; color: var(--wabi-muted); }
  .spec-quote { font-size: clamp(24px, 2.4vw, 32px); letter-spacing: -.03em; line-height: 1.2; }
  .precise { background: var(--wabi-tint); border-color: var(--wabi-outline-tint); }
  .precise .mono { color: var(--wabi-moss); }
  dl { display: grid; grid-template-columns: 130px 1fr; gap: 14px 20px; margin: 0; }
  dt { font-weight: 700; font-size: 14px; }
  dd { margin: 0; font-size: 15px; color: #2E4636; }
  @media (max-width: 900px) { .spec-grid { grid-template-columns: minmax(0, 1fr); } dl { grid-template-columns: minmax(0, 1fr); gap: 4px; } dd { margin-bottom: 12px; } }
</style>
